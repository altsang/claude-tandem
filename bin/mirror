#!/bin/bash
# `mirror` was the command of Claude MacOS Mirror, which is now Claude Tandem: it is
# `tandem`. Kept so habits, notes and scripts keep working — and the hold banner that
# `mirror hold` already wrote into held projects' instructions, which tells Claude to
# run `mirror receive`.
echo "note: 'mirror' is now 'tandem'" >&2
exec "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/tandem" "$@"
