#!/bin/bash
# tandem — the Claude Tandem CLI: run several Claude accounts on one Mac, and hand
#          Claude projects between accounts and between Macs.
#
#   Setup verbs run from this repo. Runtime verbs are delegated to the versioned
#   engine deployed in the shared tree (see bin/VERSIONING.md for why it is
#   versioned rather than edited in place).
#
#   THE DAILY PAIR — one verb per side, both block until the transfer is provable:
#
#   tandem send <Project> --to <Machine> [--note ...] [--wait]
#                                    materialize, manifest, ownership event, then wait
#                                    until every file is actually UPLOADED (--wait also
#                                    waits for the other Mac to claim it)
#   tandem receive <Project>         wait for the handoff, md5-verify every file against
#                                    the manifest, define the project here if needed,
#                                    claim it, and copy the handoff doc to the clipboard
#                                    --defer: if Claude is open, claim now and leave the
#                                    spaces.json steps for `tandem settle`
#   tandem settle [Project]          finish deferred receives once Claude has quit
#
#   WHAT IS WHERE:
#
#   tandem where [--json]            every Mac, profile and shared project: who holds what,
#                                    what is on its way, what is waiting, what isn't shared
#   tandem presence                  publish this Mac's card to the shared drive (the app
#                                    does this every few minutes)
#   tandem ask <Project>             ask whoever holds a project to hand it here
#   tandem inbox [--json]            what is waiting for a profile on this Mac: arrivals,
#                                    briefs ready to send, requests, receives settling
#   tandem inbox dismiss <key>       hide a brief or request (keys: tandem inbox)
#   tandem brief <Project> [--path|--copy] [--open]
#                                    the brief it travelled with; --open brings this
#                                    side's Claude forward with it on the clipboard
#
#   AUTOMATION — the app's background half, headless (see docs/reference.md#automation):
#
#   tandem watch [--once] [--json] [--on-event CMD] [--no-act]
#                                    poll the drive, publish presence, report events, and
#                                    receive / send / settle as `tandem config` says
#   tandem watch --install|--uninstall   run it at login as a LaunchAgent
#   tandem config [get|set <key> <value>] [--json]
#                                    on-arrival ask|auto|off · on-brief ask|auto ·
#                                    watch-interval seconds — shared with the app
#
#   SEVERAL ACCOUNTS ON ONE MAC — see `tandem profile help`:
#
#   tandem profile create|desktop|app|rename|code|quit|list|sync|doctor <p> ...
#   tandem menubar                   build and open the Claude Tandem app (menu bar + window)
#
#   tandem skill                     show the /handoff skill to add in Claude › Settings › Skills
#   tandem version                   print the installed version
#
#   tandem use-root <path>           set the shared drive root for THIS Mac
#   tandem deploy                    install/refresh tooling into the shared tree
#   tandem migrate <Project>         copy a local project's folder INTO the shared tree
#   tandem path <Project>            print the shared folder path (also copies it)
#   tandem link <Project>            DEPRECATED — symlinks break Claude folder grants
#   tandem rename <Old> <New>        rename a shared project everywhere
#
#   tandem hold <Project> --to <M>   lock THIS Mac out of a project it handed away:
#                                    unlinks the folder and puts a notice in the
#                                    project's instructions (send --hold does both)
#   tandem release <Project>         undo that (receive does it automatically)
#
#   tandem memory-snapshot <Name>    copy this Mac's project memory into the shared tree
#                                    (send does this automatically)
#   tandem memory-install <Name>     install the newest snapshot into THIS Mac's store
#                                    (receive does it): --merge adds what this Mac lacks
#                                    and flags clashes; --force replaces. Both back up first
#
#   tandem project-list              local projects defined on THIS Mac
#   tandem project-export <Name>     write a project definition into the shared tree
#   tandem project-import <Name>     add an exported definition to THIS Mac
#                                    --wait blocks until the definition AND its files land
#   tandem wait <Name>               watch the drive deliver a project, with progress
#   tandem project-repath <Name> <p> repoint a project's folder
#   tandem doctor                    everything at once: check, then profile doctor. Changes nothing
#   tandem check                     report state, change nothing
#
#   tandem status                    who owns what
#   tandem handoff <Project> --to <Machine> [--note ...] [--wait]   (send does this + more)
#   tandem pickup [Project]                                         (receive does this + more)
#   tandem log <Project>
#   tandem conflicts
#   tandem materialize [path]
#
#   PROFILES — several Claude accounts on one Mac (see bin/tandem-profile):
#   tandem --profile <p> <verb> ...  act as profile <p>: its own data folder, its own
#                                    spaces.json and memory, and its own side of a
#                                    handoff, named <Mac>@<p>. TANDEM_PROFILE does the same.
#   tandem send <Project> --to Madoka@b
#                                    hand a project to another account on this same Mac

set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Formerly Claude MacOS Mirror, configured in ~/.config/claude-macos-mirror. Fold that
# folder in once — it holds the held-project stash, so losing it would strand a held
# project — merge-safe, because `tandem profile` may have created the new one first.
CONFDIR="$HOME/.config/claude-tandem"
OLDCONF="$HOME/.config/claude-macos-mirror"
if [ -d "$OLDCONF" ] && [ ! -L "$OLDCONF" ]; then
  mkdir -p "$CONFDIR"
  for f in "$OLDCONF"/* "$OLDCONF"/.[!.]*; do
    [ -e "$f" ] || continue
    [ -e "$CONFDIR/${f##*/}" ] || mv "$f" "$CONFDIR/"
  done
  rmdir "$OLDCONF" 2>/dev/null \
    || echo "warning: $OLDCONF still has files that also exist in $CONFDIR — left in place" >&2
fi
CONF="$CONFDIR/root"
# Original folder paths, stashed while a project is held. Deliberately LOCAL and never
# in spaces.json: the app rewrites that file from memory and may drop keys it does not
# know, which would strand the project with no folder and no way back.
HOLDDIR="$CONFDIR/held"
default_root(){ echo "$HOME/Library/Mobile Documents/com~apple~CloudDocs/Claude"; }
resolve_root(){
  if [ -n "${TANDEM_ROOT:-${MIRROR_ROOT:-}}" ]; then echo "${TANDEM_ROOT:-$MIRROR_ROOT}"   # MIRROR_*: the old names
  elif [ -f "$CONF" ]; then
    local r; r="$(sed -e 's/[[:space:]]*$//' -e '/^$/d' "$CONF" | head -1)"
    echo "${r/#\~/$HOME}"
  else default_root; fi
}
ROOT="$(resolve_root)"
# Engines v5–v7 on the shared drive look for a custom root in ~/.config/claude-macos-mirror,
# a path that no longer exists, but take MIRROR_ROOT first — so hand it to every engine
# rather than keep the old folder around. (A shipped engine is never edited.)
export TANDEM_ROOT="$ROOT" MIRROR_ROOT="$ROOT"
PROJECTS="$ROOT/Projects"
HANDOFF="$ROOT/_handoff"
EVENTS="$HANDOFF/events"
ME="$(scutil --get ComputerName 2>/dev/null || hostname)"

# A profile is the real Claude app launched with its own --user-data-dir (signed builds
# ignore CLAUDE_USER_DATA_DIR; see bin/tandem-profile). Each one has its own spaces.json,
# memory and held-project stash, so it is a separate side of a handoff: <Mac>@<profile>.
PROFILE="${TANDEM_PROFILE:-${MIRROR_PROFILE:-}}"
case "${1:-}" in
  --profile)   PROFILE="${2:-}"; shift 2 || { echo "error: --profile needs a name" >&2; exit 1; };;
  --profile=*) PROFILE="${1#--profile=}"; shift;;
esac
[ "$PROFILE" = "default" ] && PROFILE=""
case "$PROFILE" in *[!A-Za-z0-9_-]*) echo "error: profile names are letters, digits, - and _" >&2; exit 1;; esac
# `tandem profile rename` gives a profile a display name and keeps its id (the folder
# suffix). Accept the name, but act as the id: the handoff identity <Mac>@<id> is what
# the shared drive's ownership events record, so it must not change with a rename.
profile_id(){   # name -> id on THIS Mac; prints the input unchanged when nothing matches
  local n="$1" f
  [ -z "$n" ] || [ -d "$HOME/.claude-$n" ] && { echo "$n"; return; }
  [ "$(cat "$HOME/.claude/.profile-name" 2>/dev/null)" = "$n" ] && { echo ""; return; }
  for f in "$HOME"/.claude-*/.profile-name; do
    [ -f "$f" ] && [ "$(cat "$f")" = "$n" ] && { f="${f%/.profile-name}"; echo "${f##*/.claude-}"; return; }
  done
  echo "$n"
}
PROFILE="$(profile_id "$PROFILE")"
BASE_ME="$ME"
USERDATA="$HOME/Library/Application Support/Claude${PROFILE:+-$PROFILE}"
ME="$ME${PROFILE:+@$PROFILE}"
HOLDDIR="$HOLDDIR${PROFILE:+-$PROFILE}"
export TANDEM_ME="$ME"   # the engine (v8+) names this side the same way

die(){ echo "error: $*" >&2; exit 1; }
ok(){ echo "  ✓ $*"; }
# --to <ThisMac>@<name> -> <ThisMac>@<id>. Only this Mac's names are known here; a
# target on the other Mac is passed through as typed, so use ids across Macs.
local_target(){
  local t="$1" mac p
  case "$t" in *@*) mac="${t%%@*}"; p="${t#*@}";; *) echo "$t"; return;; esac
  [ "$mac" = "$BASE_ME" ] || { echo "$t"; return; }
  p="$(profile_id "$p")"
  echo "$mac${p:+@$p}"
}
# This Mac's iCloud Drive sync state. A receive that waits on an event the sender has
# already uploaded is usually waiting on THIS Mac: on 2026-10-30 Ji-su's iCloud Drive had
# not synced down for 10 hours after a reboot (`brctl status`: client:needs-sync), and
# opening Finder › iCloud Drive restarted it within a minute. Prints "<state>\t<last
# sync>\t<minutes ago>", nothing off iCloud; exit 0 only when it looks stalled.
drive_state(){
  case "$ROOT" in *CloudDocs*) ;; *) return 2;; esac
  local st client last epoch age=""
  st="$(brctl status 2>/dev/null | sed $'s/\x1b\[[0-9;]*m//g')"
  client="$(printf '%s' "$st" | grep -o 'client:[a-z-]*' | head -1 | cut -d: -f2)"
  last="$(printf '%s' "$st" | grep -o 'last-sync:[0-9-]* [0-9:]*' | head -1 | cut -d: -f2-)"
  [ -n "$client$last" ] || return 2
  epoch="$(date -j -f '%Y-%m-%d %H:%M:%S' "$last" +%s 2>/dev/null)" && age=$(( ($(date +%s) - epoch) / 60 ))
  printf '%s\t%s\t%s\n' "${client:-?}" "${last:-unknown}" "$age"
  [ "$client" != idle ] && [ -n "$age" ] && [ "$age" -ge 10 ]
}
# Which Apple ID iCloud Drive syncs as — both Macs must match. Up to macOS 26 this was in
# MobileMeAccounts; on macOS 27 that plist is empty ({}) and the account is only in the
# Accounts database. Prints "unknown" rather than guess.
icloud_account(){
  local a
  a="$(defaults read MobileMeAccounts Accounts 2>/dev/null | awk -F'"' '/AccountID/{print $2; exit}')"
  [ -n "$a" ] || a="$(sqlite3 -readonly "$HOME/Library/Accounts/Accounts4.sqlite" \
      "select ZUSERNAME from ZACCOUNT where ZACCOUNTDESCRIPTION='iCloud' limit 1;" 2>/dev/null)"
  echo "${a:-unknown}"
}
drive_hint(){   # one or two lines for a person; silent when there is nothing to say
  local line client last age stalled=1
  line="$(drive_state)" && stalled=0
  [ -n "$line" ] || return 1
  IFS=$'\t' read -r client last age <<< "$line"
  if [ "$stalled" = 0 ]; then
    echo "  ⚠ this Mac's iCloud Drive looks STALLED: '$client', last synced down $last (${age} min ago)."
    echo "    Open Finder › iCloud Drive to restart it — the handoff may already be waiting upstream."
  else
    echo "  this Mac's iCloud Drive: '$client', last synced down $last${age:+ (${age} min ago)}"
  fi
}

# The receive command the target side should run.
receive_cmd(){
  local p=""; case "$1" in *@*) p="${1#*@}";; esac
  echo "tandem ${p:+--profile $p }receive \"$2\""
}

# Machine-readable progress for the app, which runs send/receive with TANDEM_STEPS=1:
# "::step::<name>::<start|done|wait|skip|fail>::<detail>". Silent in a terminal.
step(){ [ -n "${TANDEM_STEPS:-}" ] && printf '::step::%s::%s::%s\n' "$1" "$2" "${3:-}"; return 0; }

# A receive that claimed a project but could not yet touch spaces.json (this profile's
# Claude was open) leaves a settle record; `tandem settle` finishes it once Claude quits.
# Local to this Mac, one file per side+project.
SETTLEDIR="$CONFDIR/settle"
settle_file(){ printf '%s/%s--%s.json' "$SETTLEDIR" "${ME//\//_}" "${1//\//_}"; }
settle_mark(){   # project need...
  local name="$1"; shift
  mkdir -p "$SETTLEDIR"
  python3 - "$(settle_file "$name")" "$name" "$ME" "${PROFILE:-default}" "$@" <<'PY2'
import json,sys,os,datetime
f,name,side,profile=sys.argv[1:5]; needs=sys.argv[5:]
old={}
try: old=json.load(open(f))
except Exception: pass
needs=sorted(set(old.get("needs",[]))|set(needs))
json.dump({"project":name,"side":side,"profile":profile,"needs":needs,
           "at":datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")},open(f,"w"),indent=2)
PY2
}

# Engines before v8 ignore TANDEM_ME and record every event as the bare Mac name, so a
# handoff to or from a profile would be written down as the default account's.
need_profile_engine(){
  [ -n "$PROFILE" ] || return 0
  grep -q TANDEM_ME "$1" || die "the engine on the shared drive ($(basename "$1")) predates profiles: it would
     record this handoff as $BASE_ME, not $ME. Put the current one there first:  tandem deploy"
}

engine(){
  local e
  e="$(ls -1 "$HANDOFF"/bin/coworkctl-v*.sh 2>/dev/null | sort -V | tail -1)"
  [ -n "$e" ] || die "no engine deployed yet — run: tandem deploy"
  echo "$e"
}

# print the leading comment block, stopping at the first non-comment line
usage(){ awk 'NR>1 && /^#/{sub(/^# ?/,""); print; next} NR>1{exit}' "${BASH_SOURCE[0]}"; }

cmd_use_root(){
  local path="${1:-}"; [ -n "$path" ] || die "usage: tandem use-root <path-to-shared-folder>"
  path="${path/#\~/$HOME}"
  local parent; parent="$(dirname "$path")"
  [ -d "$parent" ] || die "parent does not exist: $parent
     Make sure the shared drive is mounted and synced first."
  mkdir -p "$(dirname "$CONF")"
  printf '%s\n' "$path" > "$CONF"
  ok "shared root for $ME set to: $path"
  echo "  (stored in $CONF — this is per-machine, so the two Macs may differ)"
}

cmd_deploy(){
  local parent; parent="$(dirname "$ROOT")"
  [ -d "$parent" ] \
    || die "shared drive not available at: $parent
     Mount/sync the drive, or point elsewhere:  tandem use-root <path>"
  mkdir -p "$PROJECTS" "$HANDOFF/bin"
  ok "tree ready: $ROOT"
  for f in "$HERE"/bin/coworkctl-v*.sh; do
    [ -f "$f" ] || continue
    cp "$f" "$HANDOFF/bin/$(basename "$f")"; chmod +x "$HANDOFF/bin/$(basename "$f")"
    ok "deployed $(basename "$f")"
  done
  [ -f "$HERE/bin/VERSIONING.md" ] && cp "$HERE/bin/VERSIONING.md" "$HANDOFF/bin/README.md" && ok "deployed bin/README.md"
  # Skill bundles are NOT packaged here any more. Skills sync at the account level
  # (finding 15): uploading skills/handoff/SKILL.md through Claude's own Settings on
  # ONE Mac puts it on both. A .skill zip in the shared tree duplicated that, and a
  # stale zip beside a live skill is worse than no zip -- someone installs the old
  # copy months later and silently gets superseded instructions. Removed 2026-09-26,
  # after the Aug 20 bundles outlived a correction to the skill's own premises.
  for k in handoff pickup; do
    if [ -f "$HANDOFF/$k.skill" ]; then
      rm -f "$HANDOFF/$k.skill"        # exact path, never a glob
      ok "removed stale $k.skill (skills sync at the account level)"
    fi
  done
  echo
  echo "Note: the ENGINE lives inside the shared tree, so the other Mac receives it"
  echo "through the drive automatically. The 'tandem' CLI travels by git, so run"
  echo "'git pull' over there after changing it. The /handoff SKILL is installed"
  echo "through Claude Settings -> Skills -> Add on either Mac and syncs by account."
  echo "On the other Mac you need 'tandem use-root' only if its shared path differs;"
  echo "projects arrive with 'tandem receive <Project>'."
}

cmd_check(){
  echo "machine: $ME"
  echo "claude data: $USERDATA"
  local sf; sf="$(spaces_file)" && echo "  spaces.json: ${sf#$USERDATA/}" || echo "  (no spaces.json for the signed-in account yet)"
  echo "shared root: $ROOT"
  [ -f "$CONF" ] && echo "  (from $CONF)" || echo "  (default — no config set)"
  case "$ROOT" in
    *CloudDocs*) echo "iCloud account: $(icloud_account)"
                 drive_hint || true;;
  esac
  [ -d "$ROOT" ] && ok "shared tree present" || echo "  ✗ shared tree missing (drive not synced yet?)"
  local e; e="$(ls -1 "$HANDOFF"/bin/coworkctl-v*.sh 2>/dev/null | sort -V | tail -1)"
  # no `xargs basename` — the path contains spaces
  [ -n "$e" ] && ok "engine: $(basename "$e")" || echo "  ✗ engine not deployed"
  echo "  shared projects:"
  for d in "$PROJECTS"/*/; do [ -d "$d" ] && echo "      $(basename "$d")"; done
  echo "  granted folders that will fail in Claude:"
  python3 - "$USERDATA" <<'PY'
import json,glob,os,sys
fs=[x for x in glob.glob(os.path.join(sys.argv[1],
    "local-agent-mode-sessions/*/*/spaces.json"))
    if "skills-plugin" not in x]
bad=0
for f in fs:
    try: d=json.load(open(f))
    except Exception: continue
    for s in d.get("spaces",[]):
        for x in s.get("folders") or []:
            p=x.get("path","")
            if os.path.islink(p):
                bad+=1
                print(f'      ✗ {s["name"]} — granted folder is a SYMLINK')
                print(f'          granted: {p}')
                print(f'          real:    {os.path.realpath(p)}')
                print(f'          fix: tandem project-repath "{s["name"]}" "{os.path.realpath(p)}"')
            elif not os.path.exists(p):
                bad+=1
                shared=os.path.expanduser(
                    "~/Library/Mobile Documents/com~apple~CloudDocs/Claude/Projects/"+s["name"])
                print(f'      ✗ {s["name"]} — granted folder DOES NOT EXIST')
                print(f'          granted: {p}')
                if os.path.isdir(shared):
                    print(f'          shared copy is at: {shared}')
                    print(f'          fix: tandem project-repath "{s["name"]}" "{shared}"')
                else:
                    print(f'          no shared copy found — was it migrated?')
if not bad: print("      none ✓")
PY
  return 0   # a successful report must exit 0; the loop above can leave $? non-zero
}

# One health check for the whole Mac: the handoff side (check), then whether this Claude.app
# still does what profiles rely on (profile doctor). Non-zero if the profile half fails.
cmd_doctor(){
  echo "── Handoffs"
  cmd_check
  echo
  echo "── Profiles"
  "$HERE/bin/tandem-profile" doctor "$@"
}

# Prints the shared path, and copies it, for the cases where a human still needs the
# string: attaching a folder by hand in the picker, or checking what a project points at.
# The normal path is that migrate/project-import/project-repath write it for you.
cmd_path(){
  local name="${1:-}"; [ -n "$name" ] || die "usage: tandem path <Project>"
  [ -d "$PROJECTS/$name" ] || die "'$name' is not in the shared tree ($PROJECTS)"
  echo "$PROJECTS/$name"
  # Only hijack the clipboard when a human is reading this. Inside a command
  # substitution -- cd "$(tandem path X)" -- stdout is a pipe, and copying there would
  # silently overwrite the handoff document that 'tandem receive' just put on the
  # clipboard, so the next paste lands a path instead of the brief.
  if [ -t 1 ] && command -v pbcopy >/dev/null 2>&1; then
    printf '%s' "$PROJECTS/$name" | pbcopy
    echo "  (copied to clipboard — only needed for a hand grant: Add folder, Cmd-Shift-G, paste)" >&2
  fi
}

# Kept only to explain itself. Creating the symlink is what broke folder links.
cmd_link(){
  local name="${1:-}"; [ -n "$name" ] || die "usage: tandem link <Project>"
  [ -d "$PROJECTS/$name" ] || die "'$name' is not in the shared tree ($PROJECTS)"
  echo "tandem link is deprecated and creates nothing."
  echo
  echo "Claude registers a symlinked folder as \"connected\" and then fails every read"
  echo "inside it with \"is not inside a folder connected to Cowork on this device\","
  echo "because the resolved real path falls outside the connected scope. The folder"
  echo "looks fine in the UI, which makes it hard to diagnose. Verified 2026-08-19."
  echo
  echo "Point the project at the real path instead — with Claude quit, no picker needed:"
  echo "    tandem project-repath \"$name\" \"$PROJECTS/$name\""
  echo
  echo "It is the same path on both Macs, so there is nothing to link."
}

# The project's own folder (the first one; Claude reads the project's files from it),
# from this profile's spaces.json -- not assumed from the name. Claude names a new
# project's folder after the project, but people attach folders from anywhere, and a
# project renamed in Claude keeps its old folder. Prints nothing for a project with no
# folder; fails for a name that is not a project here.
project_folder(){
  local f; f="$(spaces_file)" || return 2
  python3 - "$f" "$1" <<'PY'
import json,sys
d=json.load(open(sys.argv[1]))
e=next((x for x in d.get("spaces",[]) if x.get("name")==sys.argv[2]),None)
if e is None: sys.exit(1)
paths=[p.get("path") for p in (e.get("folders") or []) if p.get("path")]
if paths: print(paths[0])
PY
}

cmd_migrate(){
  local name="${1:-}"; [ -n "$name" ] || die "usage: tandem migrate <Project>"
  local dst="$PROJECTS/$name" src rc=0
  src="$(project_folder "$name")" || rc=$?
  if [ $rc -ne 0 ]; then
    # not a project in this profile: the old layout, a folder named after it, still moves
    src="$HOME/Documents/Claude/Projects/$name"
    [ -d "$src" ] || die "no project named '$name'${PROFILE:+ in profile $PROFILE}"
  fi
  case "$src/" in "$PROJECTS"/*) ok "'$name' already uses a folder in the shared tree"; return 0;; esac
  [ -L "$src" ] && die "$src is a symlink — Claude can't read through one. Point the project at the real folder first."
  [ -n "$src" ] && { [ -e "$src" ] || die "'$name' uses a folder that isn't on this Mac:
     $src"; }
  [ -z "$src" ] || [ -d "$src" ] || die "$src is not a folder"
  [ -e "$dst" ] && die "'$name' already exists in the shared tree.
     This Mac picks it up instead of migrating:  tandem receive \"$name\""
  # Switching the folder edits spaces.json, which a running Claude rewrites from memory.
  # Check before copying anything, so a refusal leaves nothing half done.
  [ $rc -ne 0 ] || require_claude_quit

  if [ -z "$src" ]; then
    mkdir -p "$dst" || die "could not create $dst"
    ok "'$name' had no folder: made an empty one in the shared tree"
    cmd_project_repath "$name" "$dst" >/dev/null || die "could not attach $dst to '$name'"
    ok "attached it to the project"
    echo; echo "  Relaunch Claude. Files you add to the project now land in the shared copy:"
    echo "      $dst"
    return 0
  fi

  echo "sharing '$name' from $src"
  mkdir -p "$dst"
  rsync -a --exclude '.DS_Store' "$src/" "$dst/" || die "copy failed"
  ok "copied"
  local a b
  a="$(cd "$src" && find . -type f ! -name '.DS_Store' -exec md5 -q {} \; -print | paste - - | sort)"
  b="$(cd "$dst" && find . -type f ! -name '.DS_Store' -exec md5 -q {} \; -print | paste - - | sort)"
  if [ "$a" != "$b" ]; then
    echo "VERIFICATION FAILED — nothing moved." >&2
    diff <(echo "$a") <(echo "$b") | head -20 >&2
    die "refusing to move the original"
  fi
  ok "verified $(echo "$a" | grep -c .) files identical by md5"

  # A folder Claude made for the project is set aside, so nothing keeps writing to a
  # copy the project no longer reads. One the user attached from elsewhere is theirs:
  # it stays where it is.
  case "$src/" in
    "$HOME/Documents/Claude/Projects/"*)
      local bak; bak="$(dirname "$src")/.$(basename "$src").pre-icloud-$(date +%Y%m%d-%H%M%S)"
      mv "$src" "$bak" || die "could not move original aside"
      ok "original kept at $bak";;
    *) ok "your folder stays where it was: $src";;
  esac

  if [ $rc -ne 0 ]; then
    echo "  (no project named '$name' here, so there was no folder link to switch)"
    return 0
  fi
  # Writing spaces.json IS the grant -- verified 2026-08-20, a project linked this way
  # and never touched in the picker reads fine. Its other folders are kept.
  cmd_project_repath "$name" "$dst" --replace "$src" >/dev/null \
    || die "copied, but could not switch '$name' to the shared copy. Run:
     tandem project-repath \"$name\" \"$dst\" --replace \"$src\""
  ok "the project now uses the shared copy (its other folders kept)"
  echo
  echo "  Relaunch Claude — macOS may ask once for access to the new location."
  echo "      $dst"
  echo "  That path is the same on both Macs. Keep the original until Claude reads the"
  echo "  project fine. No symlink is made: Claude refuses reads through one."
}

# Rename a shared project everywhere: the folder, its ownership history, and this
# Mac's symlink. Useful when the folder name does not match the Claude project name.
cmd_rename(){
  local old="${1:-}" new="${2:-}"
  [ -n "$old" ] && [ -n "$new" ] || die "usage: tandem rename <Old> <New>"
  [ -d "$PROJECTS/$old" ] || die "'$old' is not in the shared tree"
  [ -e "$PROJECTS/$new" ] && die "'$new' already exists in the shared tree"

  echo "renaming shared project: '$old' -> '$new'"
  mv "$PROJECTS/$old" "$PROJECTS/$new" || die "rename failed"
  ok "folder renamed"

  if [ -d "$EVENTS/$old" ]; then
    if [ -e "$EVENTS/$new" ]; then
      echo "  ! events/$new already exists — leaving events/$old in place"
    else
      mv "$EVENTS/$old" "$EVENTS/$new"; ok "ownership history moved"
    fi
  fi

  local link="$HOME/Documents/Claude/Projects/$old"
  if [ -L "$link" ]; then rm "$link"; ok "removed stale symlink $link"; fi

  # The rename broke this Mac's folder link -- it still names the old path. Repair it
  # here rather than sending the user to the file picker; writing spaces.json IS the
  # grant. Only the app being open stops us.
  if claude_running; then
    echo "  ⚠ Claude is running, so the folder link could not be updated. Quit it, then:"
    echo "        tandem project-repath \"$new\" \"$PROJECTS/$new\""
  else
    cmd_project_repath "$new" "$PROJECTS/$new" >/dev/null 2>&1 \
      && ok "folder link repointed at the renamed folder" \
      || echo "  ! could not repoint — run: tandem project-repath \"$new\" \"$PROJECTS/$new\""
  fi

  echo
  echo "  On your OTHER Mac, once iCloud catches up (Claude quit there too):"
  echo "        tandem project-repath \"$new\" \"$PROJECTS/$new\""
  echo "        rm ~/Documents/Claude/Projects/\"$old\"     # only if a stale symlink is there"
  echo "  Ownership history follows the rename; 'tandem log \"$new\"' should show it."
}

# ---- project memory ---------------------------------------------------------
#
# A local project accumulates real memory at spaces/<spaceId>/memory/ next to
# spaces.json (finding 12c) -- per-machine, and keyed by the project id that
# export/import preserve. Memory follows ownership, like the files: send
# snapshots the holder's store into the project's .handoff/memory/, receive
# installs it on the other Mac. An existing store is never overwritten silently.

space_id(){        # project name -> id, from THIS Mac's spaces.json
  local f; f="$(spaces_file)" || return 1
  python3 - "$f" "$1" <<'PY'
import json,sys
d=json.load(open(sys.argv[1]))
e=next((x for x in d.get("spaces",[]) if x.get("name")==sys.argv[2]),None)
if e is None: sys.exit(1)
print(e["id"])
PY
}

memory_dir(){      # project name -> this Mac's memory store path (may not exist yet)
  local f sid; f="$(spaces_file)" || return 1
  sid="$(space_id "$1")" || return 1
  echo "$(dirname "$f")/spaces/$sid/memory"
}

cmd_memory_snapshot(){
  local name="${1:-}"; [ -n "$name" ] || die "usage: tandem memory-snapshot <Project>"
  [ -d "$PROJECTS/$name" ] || die "'$name' is not in the shared tree"
  local src
  if ! src="$(memory_dir "$name")"; then
    echo "  no project definition on this Mac — no memory to snapshot"; return 0
  fi
  python3 - "$src" "$PROJECTS/$name/.handoff/memory" "$name" "$ME" <<'PY'
import os,sys,json,hashlib,datetime,shutil
src,outroot,name,me=sys.argv[1:5]
files=[f for f in (os.listdir(src) if os.path.isdir(src) else [])
       if os.path.isfile(os.path.join(src,f))]
if not files:
    print("  no memory on this Mac for this project — nothing to snapshot"); sys.exit(0)
ts=datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
dest=os.path.join(outroot,f"{ts}-{me}")
os.makedirs(dest)
man=[]
for f in sorted(files):
    shutil.copyfile(os.path.join(src,f),os.path.join(dest,f))
    d=os.path.join(dest,f)
    man.append({"path":f,"size":os.path.getsize(d),
                "md5":hashlib.md5(open(d,"rb").read()).hexdigest()})
json.dump({"project":name,"machine":me,"at":ts,
           "count":len(man),"bytes":sum(x["size"] for x in man),"files":man},
          open(os.path.join(dest,"snapshot.json"),"w"),indent=2)
print(f"  memory: {len(man)} file(s), {sum(x['size'] for x in man)/1000:.1f} KB -> .handoff/memory/{ts}-{me}/")
PY
}

cmd_memory_install(){
  local name="" mode=none
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) mode=force; shift;;
      --merge) mode=merge; shift;;
      *)       [ -n "$name" ] || name="$1"; shift;;
    esac
  done
  [ -n "$name" ] || die "usage: tandem memory-install <Project> [--merge|--force]"
  require_claude_quit
  local dst
  dst="$(memory_dir "$name")" || die "'$name' is not defined on this Mac — run 'tandem receive' first"
  # enumerating the chain is what makes the drive surface a snapshot that has not landed yet
  ls "$PROJECTS/$name/.handoff" "$PROJECTS/$name/.handoff/memory" >/dev/null 2>&1
  ls "$PROJECTS/$name/.handoff/memory/"*/ >/dev/null 2>&1
  python3 - "$PROJECTS/$name/.handoff/memory" "$dst" "$mode" "$ME" "$name" <<'PY'
import os,sys,json,hashlib,shutil,glob,datetime,time,re
root,dst,mode,me,name=sys.argv[1],sys.argv[2],sys.argv[3],sys.argv[4],sys.argv[5]
snaps=[d for d in sorted(glob.glob(os.path.join(root,"*")))
       if os.path.isfile(os.path.join(d,"snapshot.json"))]
if not snaps:
    print("  no memory snapshot came with this project")
    print("  (if one was just sent, the drive may still be delivering — re-run:")
    print(f"      tandem memory-install \"{name}\""); sys.exit(3)
snap=snaps[-1]
man=json.load(open(os.path.join(snap,"snapshot.json")))
if man.get("machine")==me:
    print(f"  newest memory snapshot is this Mac's own ({man['at']}) — nothing to install"); sys.exit(3)

def ensure_local(p):
    # dataless files read empty with no error; reading is what pulls them (finding 1)
    for _ in range(30):
        try: st=os.stat(p)
        except OSError: return False
        if st.st_size==0 or st.st_blocks>0: return True
        try:
            with open(p,"rb") as fh:
                while fh.read(1<<20): pass
        except OSError: return False
        time.sleep(1)
    return False

bad=[]
for f in man["files"]:
    p=os.path.join(snap,f["path"])
    if not ensure_local(p): bad.append(f["path"]); continue
    if hashlib.md5(open(p,"rb").read()).hexdigest()!=f["md5"]: bad.append(f["path"])
if bad:
    print(f"  {len(bad)} memory file(s) not fully delivered or corrupt — nothing installed:")
    for b in bad[:5]: print(f"      {b}")
    sys.exit(1)

existing=[f for f in (os.listdir(dst) if os.path.isdir(dst) else [])
          if os.path.isfile(os.path.join(dst,f))]
if existing and mode=="none":
    print(f"  this Mac already has {len(existing)} memory file(s) for '{name}' — NOT overwriting.")
    print(f"  The snapshot from {man['machine']} ({man['at']}) holds {man['count']} file(s). Either:")
    print(f"      tandem memory-install \"{name}\" --merge    # keep both: add what is new, flag clashes")
    print(f"      tandem memory-install \"{name}\" --force    # replace this Mac's with the snapshot")
    print("  Both back up the current store first."); sys.exit(3)
if existing:
    ts=datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    bak=dst.rstrip("/")+".bak-"+ts
    n=2
    while os.path.exists(bak):      # two runs in one second must not collide
        bak=f"{dst.rstrip('/')}.bak-{ts}-{n}"; n+=1
    shutil.copytree(dst,bak)
    print(f"  existing store backed up to {os.path.basename(bak)}")

# Merge: each Mac kept learning while it held the project, so neither store is a
# superset (2026-10-30: Madoka's 11 memories had the method, Ji-su's 1 had the newest
# status). Add what this Mac lacks, never overwrite; a file that differs keeps this
# Mac's version and parks the other beside it, unindexed, for a person to reconcile.
if existing and mode=="merge":
    def md5(p): return hashlib.md5(open(p,"rb").read()).hexdigest()
    def targets(text): return set(re.findall(r"\]\(([^)]+)\)", text))
    idx_here=os.path.join(dst,"MEMORY.md")
    here_text=open(idx_here,encoding="utf-8").read() if os.path.exists(idx_here) else ""
    added,same,clash=[],[],[]
    for f in man["files"]:
        p=f["path"]
        if p=="MEMORY.md": continue
        src,out=os.path.join(snap,p),os.path.join(dst,p)
        if not os.path.exists(out): shutil.copyfile(src,out); added.append(p)
        elif md5(out)==f["md5"]: same.append(p)
        else:
            stem,ext=os.path.splitext(p)
            aside=f"{stem}.from-{man['machine']}{ext}"
            shutil.copyfile(src,os.path.join(dst,aside)); clash.append((p,aside))
    # index: keep this Mac's lines; add the other's lines for memories just added
    their_idx=os.path.join(snap,"MEMORY.md")
    new_lines=[]
    if os.path.exists(their_idx):
        have=targets(here_text)
        for line in open(their_idx,encoding="utf-8").read().splitlines():
            t=targets(line)
            if t and t<=set(added) and not (t & have): new_lines.append(line)
    if new_lines:
        with open(idx_here,"a",encoding="utf-8") as fh:
            if here_text and not here_text.endswith("\n"): fh.write("\n")
            fh.write("\n".join(new_lines)+"\n")
    print(f"  merged memory from {man['machine']} ({man['at']}): {len(added)} added, {len(same)} already identical, {len(clash)} clash")
    for p,aside in clash:
        print(f"    clash: kept this Mac's {p}; {man['machine']}'s version is {aside} (not indexed) — compare and keep one")
    kept=len([f for f in existing if f!="MEMORY.md"])
    print(f"    this Mac's own {kept} memor{'y' if kept==1 else 'ies'} kept as they were")
    sys.exit(0)

if existing:
    for f in existing: os.remove(os.path.join(dst,f))
os.makedirs(dst,exist_ok=True)
for f in man["files"]:
    shutil.copyfile(os.path.join(snap,f["path"]),os.path.join(dst,f["path"]))
print(f"  installed {man['count']} memory file(s) from {man['machine']} ({man['at']}) — {man['bytes']/1000:.1f} KB")
PY
  local rc=$?
  case $rc in
    0) echo "  Relaunch Claude. Sessions here now start with the other Mac's memory.";;
    3) rc=0;;   # a no-op is a success, just not one worth a relaunch prompt
  esac
  return $rc
}

# ---- checkout lock ----------------------------------------------------------
#
# A handed-off project still sits on this Mac, fully readable, and nothing in iCloud
# stops you editing it. Two writers to one synced folder fork rather than merge, so the
# ownership log needs teeth on the sending side.
#
# Two spaces.json writes do it, both per-machine and both reversible:
#   1. a banner prepended to the project's instructions. Verified 2026-08-20: a local
#      project's instructions land verbatim in the Claude session's systemPrompt, so
#      the assistant reads the notice before you type and can refuse.
#   2. folders[] emptied, so the session cannot read a byte even if it ignores the
#      banner.
# The banner is wrapped in markers that export and import always strip -- otherwise
# "CHECKED OUT TO Ji-su" would travel TO Ji-su on the next send.
# The marker keeps its old name: banners already written into projects carry it.
HOLD_OPEN="<!-- mirror:hold -->"
HOLD_CLOSE="<!-- /mirror:hold -->"

cmd_hold(){
  local name="" to=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --to) to="$(local_target "${2:-}")"; shift 2;;
      *)    [ -n "$name" ] || name="$1"; shift;;
    esac
  done
  [ -n "$name" ] || die "usage: tandem hold <Project> --to <Machine>"
  require_claude_quit
  local f; f="$(spaces_file)" || die "no spaces.json on this Mac"
  mkdir -p "$HOLDDIR"
  cp "$f" "$f.bak-$(date +%Y%m%d-%H%M%S)"
  python3 - "$f" "$name" "${to:-the other Mac}" "$HOLDDIR/$name.json" "$HOLD_OPEN" "$HOLD_CLOSE" <<'PY'
import json,sys,os,datetime
dst,name,to,stash,OPEN,CLOSE=sys.argv[1:7]
d=json.load(open(dst))
e=next((x for x in d.get("spaces",[]) if x.get("name")==name),None)
if e is None: print(f'no local project named "{name}"',file=sys.stderr); sys.exit(1)
folders=e.get("folders") or []
if not folders and os.path.exists(stash):
    print(f'  "{name}" is already held'); sys.exit(0)
json.dump({"project":name,"folders":folders,
           "held_at":datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ"),
           "to":to}, open(stash,"w"), indent=2)
ts=datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d %H:%MZ")
banner=(f"{OPEN}\n"
  f"CHECKED OUT TO {to} since {ts}.\n"
  f"This machine does NOT hold this project. Do not create, edit, move or delete any\n"
  f"file in the project folder -- {to} is working in it, and two writers to one synced\n"
  f"folder produce conflict copies, not merges. If you are asked to change anything\n"
  f"here, refuse and say the project is checked out to {to}.\n"
  f'To bring it back, the user runs in a terminal:  tandem receive "{name}"\n'
  f"{CLOSE}\n\n")
instr=e.get("instructions") or ""
import re
instr=re.sub(re.escape(OPEN)+r".*?"+re.escape(CLOSE)+r"\n*","",instr,flags=re.S)
e["instructions"]=banner+instr
e["folders"]=[]
json.dump(d,open(dst,"w"),indent=2)
print(f'  "{name}" held for {to}')
print(f'      folder unlinked ({len(folders)} path(s) stashed) — Claude here can read nothing')
print(f'      notice added to the project instructions — sessions here will refuse to edit')
PY
  echo "  Relaunch Claude. Release it with:  tandem release \"$name\"   (or 'tandem receive')"
}

cmd_release(){
  local name="${1:-}"; [ -n "$name" ] || die "usage: tandem release <Project>"
  require_claude_quit
  local f; f="$(spaces_file)" || die "no spaces.json on this Mac"
  cp "$f" "$f.bak-$(date +%Y%m%d-%H%M%S)"
  python3 - "$f" "$name" "$HOLDDIR/$name.json" "$PROJECTS/$name" "$HOLD_OPEN" "$HOLD_CLOSE" <<'PY'
import json,sys,os,re
dst,name,stash,fallback,OPEN,CLOSE=sys.argv[1:7]
d=json.load(open(dst))
e=next((x for x in d.get("spaces",[]) if x.get("name")==name),None)
if e is None: print(f'no local project named "{name}"',file=sys.stderr); sys.exit(1)
instr=e.get("instructions") or ""
had=OPEN in instr
e["instructions"]=re.sub(re.escape(OPEN)+r".*?"+re.escape(CLOSE)+r"\n*","",instr,flags=re.S)
folders=e.get("folders") or []
if not folders:
    if os.path.exists(stash):
        folders=json.load(open(stash)).get("folders") or []
    if not folders:
        folders=[{"path":fallback}]      # canonical shared path; tandem always uses it
    e["folders"]=folders
json.dump(d,open(dst,"w"),indent=2)
if os.path.exists(stash): os.remove(stash)
print(f'  "{name}" released' + ('' if had else ' (no hold notice was present)'))
for x in e["folders"]: print(f'      folder: {x.get("path")}')
PY
  echo "  Relaunch Claude."
}

# ---- local project definitions (spaces.json) --------------------------------
#
# A project with a folder attached is machine-bound: it lives in this Mac's
# spaces.json and never reaches the web or the other Mac. The file is plain JSON,
# so a project CAN be copied -- export it into the shared tree here, import it
# there. What does not come across is the conversation history; that is what the
# handoff document carries.
#
# All of these refuse to run while Claude is open, because a live app rewrites
# spaces.json from memory and would discard the edit.

# One data folder holds a directory per account (<account>/<org>/) for every account
# ever signed in there, so "the first spaces.json" can belong to an account that is
# not the one signed in. config.json's lastKnownAccountUuid names the current one;
# within it, prefer the org that already has a spaces.json, newest first.
spaces_file(){
  python3 - "$USERDATA" <<'PY'
import json,os,sys,glob
ud=sys.argv[1]; base=os.path.join(ud,"local-agent-mode-sessions")
try: acct=json.load(open(os.path.join(ud,"config.json"))).get("lastKnownAccountUuid")
except Exception: acct=None
def newest(pat):
    fs=[f for f in glob.glob(pat) if "skills-plugin" not in f]
    return max(fs,key=os.path.getmtime) if fs else None
f=newest(os.path.join(base,acct,"*","spaces.json")) if acct else newest(os.path.join(base,"*","*","spaces.json"))
if not f: sys.exit(1)
print(f)
PY
}

# A profile that has never had a project has no spaces.json: Claude writes it with the
# first one. Junipera on both Macs was in that state on 2026-11-09, so a project handed to
# it verified every file and then failed to define. Once the profile has signed in, its
# account and org folders exist, so start the file there. Prints the path; exit 1 unless
# there is exactly one org folder to put it in. Callers must have checked Claude is quit.
spaces_file_new(){
  python3 - "$USERDATA" <<'PY'
import json,os,sys
ud=sys.argv[1]; base=os.path.join(ud,"local-agent-mode-sessions")
try: acct=json.load(open(os.path.join(ud,"config.json"))).get("lastKnownAccountUuid")
except Exception: acct=None
d=os.path.join(base,acct) if acct else ""
orgs=[o for o in os.listdir(d) if os.path.isdir(os.path.join(d,o))] if d and os.path.isdir(d) else []
if len(orgs)!=1: sys.exit(1)
f=os.path.join(d,orgs[0],"spaces.json")
if os.path.exists(f): sys.exit(1)
json.dump({"spaces":[]},open(f,"w"),indent=2)
print(f)
PY
}

# Is THIS profile's Claude running? Other profiles' windows do not rewrite our
# spaces.json, so they must not block us. The main process is the one whose argv[0]
# is .../Contents/MacOS/Claude; helpers live under Frameworks/.
claude_running(){
  ps -axo args= | awk -v want="${PROFILE:+--user-data-dir=$USERDATA}" '
    $1 ~ /\/Claude\.app\/Contents\/MacOS\/Claude$/ {
      has = index($0, "--user-data-dir=") > 0
      if ((want == "" && !has) || (want != "" && index($0, want) > 0)) found=1   # no early exit: under pipefail it would SIGPIPE ps
    }
    END { exit !found }'
}

# A manifest of the project's files, so the receiving Mac can show real progress and
# verify on arrival rather than guessing when the drive is "done". Written by both
# project-export and send; `wait_for_files` reads whichever is newest.
write_manifest(){
  local name="$1"
  mkdir -p "$HANDOFF/projects"
  python3 - "$PROJECTS/$name" "$HANDOFF/projects" "$name" <<'PY'
import os,sys,json,hashlib
import datetime
root,outdir,name=sys.argv[1],sys.argv[2],sys.argv[3]
ts=datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
dest=os.path.join(outdir,f"{name}.{ts}.manifest.json")
files=[]
for dp,_,fn in os.walk(root):
    if ".handoff" in dp.split(os.sep): continue
    for f in fn:
        if f==".DS_Store": continue
        fp=os.path.join(dp,f); rel=os.path.relpath(fp,root)
        try:
            h=hashlib.md5(open(fp,"rb").read()).hexdigest()
            files.append({"path":rel,"size":os.path.getsize(fp),"md5":h})
        except OSError: pass
json.dump({"project":name,"files":files,
           "count":len(files),"bytes":sum(f["size"] for f in files)},
          open(dest,"w"),indent=2)
print(f'  manifest: {len(files)} files, {sum(f["size"] for f in files)/1000:.1f} KB')
PY
}

# Newest ownership event as: verb, machine, to, at, doc. Non-zero if there is none.
# Filenames lead with the UTC timestamp, so sorting them is sorting by time.
# Exit 1 = no event on the drive. Exit 2 = an event is THERE but will not parse.
# Those are different problems and must not report as the same one: "none" sent a
# 15-minute receive at the wrong Mac on 2026-09-06 when the event was sitting in the
# folder the whole time, dataless.
newest_event(){
  python3 - "$PROJECTS/$1/.handoff/events" <<'PY'
import os,sys,json,glob
fs=sorted(glob.glob(os.path.join(sys.argv[1],"*.json")))
if not fs: sys.exit(1)
f=fs[-1]
# Events arrive DATALESS like everything else on the drive -- right size in a listing,
# no content, and a read returns empty with NO error. wait_for_files pulls the project
# this way but deliberately skips .handoff/, so nothing else ever materializes the one
# file receive has to read FIRST. Force it here, with the same whole-file binary read
# present() uses, or receive waits out its entire timeout on an event already delivered.
try:
    st=os.stat(f)
    if st.st_size>0 and st.st_blocks==0:
        with open(f,"rb") as fh:
            while fh.read(1<<20): pass
except OSError: pass
try: e=json.load(open(f))
except Exception: sys.exit(2)
print("\t".join([e.get("verb",""),e.get("machine",""),e.get("to","") or "",
                 e.get("at",""),e.get("handoff_doc","") or ""]))
PY
}

# Does THIS Mac already define the project? Decides whether receive has to touch
# spaces.json at all -- and therefore whether Claude must be quit.
have_project(){
  local f; f="$(spaces_file)" || return 1
  python3 - "$f" "$1" <<'PY'
import json,sys
d=json.load(open(sys.argv[1]))
sys.exit(0 if any(x.get("name")==sys.argv[2] for x in d.get("spaces",[])) else 1)
PY
}

# newest exported definition for a project, or empty. Timestamped names sort last;
# the bare <Name>.json is the pre-timestamp layout.
find_definition(){
  local name="$1" src
  src="$(ls -1 "$HANDOFF/projects/$name."*.json 2>/dev/null | grep -v '\.manifest\.json$' | sort | tail -1)"
  [ -n "$src" ] || { [ -f "$HANDOFF/projects/$name.json" ] && src="$HANDOFF/projects/$name.json"; }
  echo "$src"
}

require_claude_quit(){
  if claude_running; then
    die "Claude is running. Quit it first — a live app rewrites spaces.json from memory
     and will silently discard this change."
  fi
}

cmd_project_list(){
  local f; f="$(spaces_file)" || die "no spaces.json found (has Claude ever run on this Mac?)"
  python3 - "$f" <<'PY'
import json,sys,os
d=json.load(open(sys.argv[1]))
sp=d.get("spaces",[])
print(f"{len(sp)} local project(s) on this Mac:")
for x in sp:
    paths=[p.get("path") for p in (x.get("folders") or [])]
    bad=[p for p in paths if not os.path.exists(p)]
    print(f'  {x["name"]}')
    for p in paths:
        print(f'      {"✗" if p in bad else "•"} {p}')
PY
}

cmd_project_export(){
  local name="${1:-}"; [ -n "$name" ] || die "usage: tandem project-export <Name>"
  local f; f="$(spaces_file)" || die "no spaces.json on this Mac"
  mkdir -p "$HANDOFF/projects"
  python3 - "$f" "$name" "$HANDOFF/projects" <<'PY'
import json,sys,os
src,name,outdir=sys.argv[1],sys.argv[2],sys.argv[3]
d=json.load(open(src))
e=next((x for x in d.get("spaces",[]) if x["name"]==name),None)
if e is None:
    print(f'no local project named "{name}". Try: tandem project-list',file=sys.stderr); sys.exit(1)
out=dict(e)
# A hold banner is about THIS Mac's checkout state. Shipping it would tell the other
# Mac its own project is checked out to itself, in its system prompt, forever.
import re
_open,_close="<!-- mirror:hold -->","<!-- /mirror:hold -->"
if out.get("instructions"):
    out["instructions"]=re.sub(re.escape(_open)+r".*?"+re.escape(_close)+r"\n*","",
                               out["instructions"],flags=re.S)
# folder paths are per-machine; the importer sets its own
out["folders"]=[]
out["_exported_from_paths"]=[p.get("path") for p in (e.get("folders") or [])]
# NEW file each time, never an overwrite: the drive does not reliably propagate an
# in-place modification of a file the other Mac has already read. Same reason the
# engine filename carries a version and the event log is append-only.
import datetime
ts=datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
dest=os.path.join(outdir,f"{name}.{ts}.json")
json.dump(out,open(dest,"w"),indent=2)
print(f'  exported "{name}" -> _handoff/projects/{name}.{ts}.json')
print(f'  instructions: {"yes" if e.get("instructions") else "none"}')
PY
  write_manifest "$name"
  echo "  The other Mac picks it up with:  tandem project-import \"$name\""
}

cmd_project_import(){
  require_claude_quit
  local name="" wait=0 timeout=600
  while [ $# -gt 0 ]; do
    case "$1" in
      --wait)    wait=1; shift;;
      --timeout) timeout="${2:-}"; shift 2;;
      *)         [ -n "$name" ] || name="$1"; shift;;
    esac
  done
  [ -n "$name" ] || die "usage: tandem project-import <Name> [--wait] [--timeout SECONDS]"
  local src; src="$(find_definition "$name")"
  if [ "$wait" = 1 ]; then
    local start=$SECONDS
    if [ -z "$src" ]; then
      echo "waiting for the definition to arrive from the other Mac..."
      while [ $((SECONDS-start)) -lt "$timeout" ]; do
        ls "$HANDOFF" >/dev/null 2>&1; ls "$HANDOFF/projects" >/dev/null 2>&1
        src="$(find_definition "$name")"
        [ -n "$src" ] && { echo "  arrived after ~$((SECONDS-start))s"; break; }
        printf "\r  %ds" $((SECONDS-start)); sleep 6
      done
      echo
      [ -n "$src" ] || die "the definition never arrived (waited ${timeout}s).
     Run 'tandem project-export \"$name\"' on the other Mac, and check it is awake."
    fi
    # The definition is a few hundred bytes and lands first. The FILES are the slow part,
    # and they arrive DATALESS -- listed at full size with no content -- so only a read
    # materializes them. Importing before that gives Claude a project whose files read
    # empty, with nothing to indicate why. Same loop `tandem wait` uses; md5-verified.
    local left=$(( timeout - (SECONDS - start) ))
    [ "$left" -lt 60 ] && left=60
    echo "waiting for the project's files..."
    wait_for_files "$name" "$left" || die "the files did not all arrive, or differ from the
     manifest (see above) — nothing was imported.
     Re-run when the other Mac is awake, or import the definition alone with
     'tandem project-import \"$name\"' and materialize later with 'tandem wait \"$name\"'."
  fi
  [ -n "$src" ] && [ -f "$src" ] || die "no exported definition for \"$name\" in $HANDOFF/projects
     Run 'tandem project-export \"$name\"' on the other Mac first, and give the drive time to sync."
  local f
  if f="$(spaces_file)"; then cp "$f" "$f.bak-$(date +%Y%m%d-%H%M%S)"
  else f="$(spaces_file_new)" || die "this profile has no projects list yet, and no account folder to start one in.
     Open Claude${PROFILE:+ ($PROFILE)}, start any task so it sets up the account, quit it, and run this again."
    echo "  first project in this profile — started its projects list"
  fi
  python3 - "$f" "$src" "$PROJECTS" <<'PY'
import json,sys,os
dst,src,projects=sys.argv[1],sys.argv[2],sys.argv[3]
d=json.load(open(dst)); e=json.load(open(src))
exported=e.pop("_exported_from_paths",None) or []
import re
_open,_close="<!-- mirror:hold -->","<!-- /mirror:hold -->"
if e.get("instructions"):   # defensive: a definition exported by an older version
    e["instructions"]=re.sub(re.escape(_open)+r".*?"+re.escape(_close)+r"\n*","",
                             e["instructions"],flags=re.S)
name=e["name"]
if any(x.get("id")==e.get("id") or x.get("name")==name for x in d.get("spaces",[])):
    print(f'  "{name}" already exists on this Mac — nothing to do'); sys.exit(0)
# always the shared path -- never ~/Documents, which is usually a symlink and
# a symlinked grant registers as connected then fails every read.
path = os.path.join(projects, name)
# The project's own folder becomes the shared copy. Its other folders (a Google Drive
# folder, say) come along when the same path exists on this Mac and isn't a symlink;
# the rest are listed so they can be added by hand.
own_local = os.path.join(os.path.expanduser("~/Documents/Claude/Projects"), name)
extra, missing = [], []
for p in exported:
    if not p or p in (path, own_local) or p.startswith(projects + os.sep): continue
    (extra if os.path.isdir(p) and not os.path.islink(p) else missing).append(p)
e["folders"]=[{"path":path}]+[{"path":p} for p in extra]
d.setdefault("spaces",[]).insert(0,e)
json.dump(d,open(dst,"w"),indent=2)
print(f'  added "{name}"')
print(f'  folder: {path}' + ('' if os.path.exists(path) else '   <-- not delivered yet; tandem receive will wait for it'))
for p in extra: print(f'  also:   {p}')
for p in missing: print(f'  ! not on this Mac, so left out: {p}')
PY
  echo "  Relaunch Claude. The project appears with its name and instructions."
  echo "  Its chat history will be empty — that is expected; the handoff document carries"
  echo "  the context, and 'tandem receive' hands it to you."
}

cmd_project_repath(){
  require_claude_quit
  local name="" path="" replace=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --replace) replace="${2:-}"; shift 2;;
      *) if [ -z "$name" ]; then name="$1"; elif [ -z "$path" ]; then path="$1"; fi; shift;;
    esac
  done
  [ -n "$name" ] && [ -n "$path" ] || die "usage: tandem project-repath <Name> <folder-path> [--replace <old-path>]"
  path="${path/#\~/$HOME}"
  [ -e "$path" ] || die "no such path: $path"
  local f; f="$(spaces_file)" || die "no spaces.json on this Mac"
  cp "$f" "$f.bak-$(date +%Y%m%d-%H%M%S)"
  python3 - "$f" "$name" "$path" "$replace" <<'PY'
import json,sys
dst,name,path,replace=sys.argv[1],sys.argv[2],sys.argv[3],sys.argv[4]
d=json.load(open(dst))
e=next((x for x in d.get("spaces",[]) if x["name"]==name),None)
if e is None: print(f'no local project named "{name}"',file=sys.stderr); sys.exit(1)
old=[p.get("path") for p in (e.get("folders") or [])]
if replace:
    # swap that one folder, keep the project's others (a Google Drive folder, say) — and
    # the new one first, where Claude looks for the project's own files
    rest=[{"path":p} for p in old if p not in (replace, path)]
    e["folders"]=[{"path":path}]+rest
else:
    e["folders"]=[{"path":path}]
json.dump(d,open(dst,"w"),indent=2)
print(f'  "{name}" folders: {old} -> {[x["path"] for x in e["folders"]]}')
PY
  echo "  Relaunch Claude for it to take effect."
}

# Watch the shared drive deliver a project, with progress. Entirely local -- it polls
# this Mac's own disk. The parent-chain enumeration matters: iCloud does not push to
# an idle Mac, and listing only the leaf directory will not surface new files.
# Shared by `tandem wait` and `tandem project-import --wait`; returns non-zero on
# timeout or md5 mismatch so callers can refuse to proceed.
wait_for_files(){
  local name="$1" timeout="$2"
  local man
  man="$(ls -1 "$HANDOFF/projects/$name."*.manifest.json 2>/dev/null | sort | tail -1)"
  [ -n "$man" ] || man="$HANDOFF/projects/$name.manifest.json"   # pre-timestamp layout
  python3 - "$PROJECTS" "$name" "$man" "$timeout" "$HANDOFF" <<'PY'
import os,sys,json,time,hashlib
projects,name,man,timeout,handoff=sys.argv[1],sys.argv[2],sys.argv[3],int(sys.argv[4]),sys.argv[5]
root=os.path.join(projects,name)

def enumerate_chain():
    # touching each level is what makes the drive surface new entries
    for d in (handoff,os.path.join(handoff,"projects"),projects,root,
              os.path.join(root,".handoff"),os.path.join(root,".handoff","events")):
        try: os.listdir(d)
        except OSError: pass

def present(pull=True):
    """Survey the project. Files arrive DATALESS -- listed with the right size but no
    content -- and nothing materializes them except a read. So this reads anything not
    yet materialized rather than waiting for a state that would never arrive on its own."""
    out={}
    for dp,_,fn in os.walk(root):
        if ".handoff" in dp.split(os.sep): continue
        for f in fn:
            if f==".DS_Store": continue
            fp=os.path.join(dp,f)
            try: st=os.stat(fp)
            except OSError: continue
            if pull and st.st_size>0 and st.st_blocks==0:
                try:
                    with open(fp,"rb") as fh:
                        while fh.read(1<<20): pass
                    st=os.stat(fp)
                except OSError: pass
            out[os.path.relpath(fp,root)]=(st.st_size, st.st_blocks>0)
    return out

expected=None
if os.path.exists(man):
    try: expected=json.load(open(man))
    except Exception: pass

start=time.time(); last=""
while time.time()-start<timeout:
    enumerate_chain()
    p=present()
    have=len(p); mat=sum(1 for v in p.values() if v[1]); byts=sum(v[0] for v in p.values())
    el=int(time.time()-start)
    if expected:
        n=expected["count"]; tb=expected["bytes"]
        pct=int(100*mat/n) if n else 100
        # A project can hold MORE files than its manifest -- work continued after the
        # handoff. Clamp the bar so it stays 20 cells; the raw counts below stay honest.
        fill=min(20,max(0,pct//5))
        bar="█"*fill+"░"*(20-fill)
        line=f"  [{bar}] {pct:3d}%  {mat}/{n} files materialized, {byts/1000:.0f}/{tb/1000:.0f} KB   {el}s"
    else:
        line=f"  {have} files present, {mat} materialized, {byts/1000:.0f} KB   {el}s"
    if line!=last: print("\r"+line,end="",flush=True); last=line
    if expected and mat>=expected["count"]:
        print()
        bad=[]
        for f in expected["files"]:
            fp=os.path.join(root,f["path"])
            try:
                if hashlib.md5(open(fp,"rb").read()).hexdigest()!=f["md5"]: bad.append(f["path"])
            except OSError: bad.append(f["path"])
        if bad:
            # EXIT 2, not 1: these files ARE here. They were delivered and then edited,
            # which is a different thing from never arriving and must not print as it.
            print(f"  {len(bad)} of {expected['count']} file(s) differ from the manifest:")
            for b in bad[:5]: print(f"      {b}")
            if len(bad)>5: print(f"      … and {len(bad)-5} more")
            sys.exit(2)
        print(f'  ✓ all {expected["count"]} files delivered and verified by md5 in {el}s')
        sys.exit(0)
    # no manifest: settle for two quiet rounds
    if not expected and have and mat==have:
        time.sleep(6); enumerate_chain()
        if len(present(pull=False))==have:
            print(f"\n  ✓ {have} files present and materialized ({el}s); no manifest, so unverified")
            sys.exit(0)
    time.sleep(3)
print(f"\n  timed out after {timeout}s — the other Mac may be asleep, or the drive is still working")
sys.exit(1)
PY
}

# Wait until the drive has actually UPLOADED the project, not merely stored it locally.
# `isUploaded` from fileproviderctl is the only signal that works on a FileProvider-backed
# iCloud Drive: brctl status returns "Client zone not found", and mdls reports the
# kMDItemUbiquitous* keys as null. Measured 2026-08-20: a fresh 25MB file reads
# isUploaded=0 and flips to 1 after ~110s. Do NOT use isUploading -- it stayed 0 for
# that entire upload. Includes .handoff/, because the ownership event is the part that
# tells the other Mac it owns the project.
wait_uploaded(){
  local name="$1" timeout="$2" man
  man="$(ls -1 "$HANDOFF/projects/$name."*.manifest.json 2>/dev/null | sort | tail -1)"
  python3 - "$PROJECTS/$name" "$timeout" "$man" <<'PY'
import os,sys,subprocess,re,time
root,timeout,man=sys.argv[1],int(sys.argv[2]),sys.argv[3]

def files():
    out=[]
    for dp,_,fn in os.walk(root):
        for f in fn:
            if f==".DS_Store": continue
            out.append(os.path.join(dp,f))
    if man and os.path.exists(man): out.append(man)
    return out

def uploaded(p):
    try:
        o=subprocess.run(["fileproviderctl","evaluate",p],capture_output=True,
                         text=True,timeout=30).stdout
    except Exception:
        return None
    m=re.search(r"isUploaded = (\d+);",o)
    return None if m is None else m.group(1)=="1"

fs=files()
if not fs: print("  no files to upload"); sys.exit(0)
probe=uploaded(fs[0])
if probe is None:
    print("  ! this drive does not report upload state — cannot verify the upload here.")
    print("    Delivery is still proven by the other Mac claiming the project.")
    sys.exit(2)

start=time.time(); last=""
while time.time()-start<timeout:
    fs=files()
    pending=[f for f in fs if uploaded(f) is not True]
    el=int(time.time()-start)
    pct=int(100*(len(fs)-len(pending))/len(fs)) if fs else 100
    bar="█"*(pct//5)+"░"*(20-pct//5)
    line=f"  [{bar}] {pct:3d}%  {len(fs)-len(pending)}/{len(fs)} files uploaded   {el}s"
    if line!=last: print("\r"+line,end="",flush=True); last=line
    if not pending:
        print(f"\n  ✓ all {len(fs)} files uploaded to the drive in {el}s"); sys.exit(0)
    time.sleep(5)
print(f"\n  {len(pending)} file(s) still not uploaded after {timeout}s:")
for f in pending[:5]: print(f"      {os.path.relpath(f,root)}")
sys.exit(1)
PY
}

# One verb for the whole send side: materialize, manifest, ownership event, and then
# proof that the bytes actually left this Mac. Replaces migrate/project-export/handoff/
# materialize as a daily flow, and adds the upload check that had no equivalent.
cmd_send(){
  local name="" to="" note="" doc="" nodoc=0 wait_ack=0 force=0 hold=0 timeout=900
  while [ $# -gt 0 ]; do
    case "$1" in
      --to)      to="$(local_target "${2:-}")"; shift 2;;
      --note)    note="${2:-}"; shift 2;;
      --doc)     doc="${2:-}"; shift 2;;
      --no-doc)  nodoc=1; shift;;
      --wait)    wait_ack=1; shift;;
      --hold)    hold=1; shift;;
      --force)   force=1; shift;;
      --timeout) timeout="${2:-}"; shift 2;;
      *)         [ -n "$name" ] || name="$1"; shift;;
    esac
  done
  [ -n "$name" ] || die "usage: tandem send <Project> --to <Machine> [--note ...] [--doc FILE] [--no-doc] [--hold] [--force] [--wait]"
  [ -n "$to" ]   || die "--to <Machine> is required — name the Mac receiving this work"
  take_lock "project-$name"
  [ "$to" = "$ME" ] && die "--to is this Mac ($ME) — send to the other one"
  [ -d "$PROJECTS/$name" ] || die "'$name' is not in the shared tree ($PROJECTS)
     Move it there first:  tandem migrate \"$name\""

  local e; e="$(engine)" || exit 1
  grep -q -- '--doc)' "$e" || die "the deployed engine is too old for this (no --doc).
     Refresh it:  tandem deploy"
  need_profile_engine "$e"

  # Do not send what this Mac does not hold. receive refuses to claim a project that was
  # not handed to it; without the mirror-image check here, a forgotten handoff could be
  # re-sent from under the Mac that already claimed it -- both Macs then believe they own
  # it, which is precisely how iCloud conflict copies get made.
  if [ "$force" = 0 ] && ev="$(newest_event "$name")"; then
    IFS=$'\t' read -r verb machine evto at _doc <<< "$ev"
    local owner="$machine"; [ "$verb" = "handoff" ] && owner="$evto"
    if [ "$owner" != "$ME" ]; then
      if [ "$verb" = "handoff" ] && [ "$machine" = "$ME" ]; then
        echo "  note: re-sending — $ME handed '$name' to $evto at $at and it was never claimed"
      else
        die "'$name' is held by '$owner', not $ME (newest event: $verb by $machine at $at).
     $owner may be editing it right now; sending would leave both Macs believing they own it.
     Look first:  tandem log \"$name\"
     If you are certain it is stale:  tandem send \"$name\" --to $to --force"
      fi
    fi
  fi

  # Context first. Files without the reasoning behind them is the failure this repo
  # exists to prevent, so refuse rather than quietly ship a bare folder.
  if [ "$nodoc" = 0 ]; then
    if [ -n "$doc" ]; then
      [ -f "$PROJECTS/$name/$doc" ] || die "no such handoff document: $doc"
    else
      doc="$(cd "$PROJECTS/$name" && ls -t HANDOFF*.md 2>/dev/null | head -1)"
      [ -n "$doc" ] || die "no HANDOFF*.md in '$name' — nothing would carry the context.
     Run /handoff in the Claude session that did the work; it writes the document.
     To send the files anyway:  tandem send \"$name\" --to $to --no-doc"
    fi
    # A document older than the last handoff event is almost certainly the previous
    # topic's, left in the folder. Warn -- the user may genuinely be resending.
    if ev="$(newest_event "$name")"; then
      IFS=$'\t' read -r _v _m _t at _d <<< "$ev"
      python3 - "$PROJECTS/$name/$doc" "$at" <<'PY' || true
import os,sys,datetime
p,at=sys.argv[1],sys.argv[2]
try: ev=datetime.datetime.strptime(at,"%Y%m%dT%H%M%SZ").replace(tzinfo=datetime.timezone.utc)
except Exception: sys.exit(0)
mt=datetime.datetime.fromtimestamp(os.path.getmtime(p),datetime.timezone.utc)
if mt<ev: print(f"  ! {os.path.basename(p)} is older than the last handoff event ({at}) — stale topic?")
PY
    fi
  fi

  echo "sending '$name': $ME -> $to"
  [ -n "$doc" ] && echo "  document: $doc" || echo "  document: none (--no-doc)"
  [ -n "$doc" ] && step brief done "$doc" || step brief skip
  step prepare start
  echo "materializing (so real bytes exist to upload):"
  bash "$e" materialize "$PROJECTS/$name" || echo "  (proceeding despite warnings)"
  # Ship the project definition alongside the files, so the first receive on a Mac that
  # has never seen this project can define it without a separate project-export. Both
  # this and the manifest are written as NEW timestamped files, never overwritten --
  # iCloud does not reliably propagate an in-place edit the peer has already cached.
  if have_project "$name"; then
    cmd_project_export "$name" | sed -n '/exported/p;/instructions:/p;/manifest:/p'
    cmd_memory_snapshot "$name"
  else
    echo "  ! '$name' is not defined as a project on this Mac — sending files only"
    write_manifest "$name"
  fi
  # array, not ${doc:+--doc "$doc"} -- that form collapses to a single argument under
  # shells that do not word-split unquoted expansions, and this file gets sourced.
  local -a docarg=(); [ -n "$doc" ] && docarg=(--doc "$doc")
  step prepare done
  # ${a[@]+"${a[@]}"}: an empty array is "unbound" to macOS's bash 3.2 under set -u, and
  # that failure used to vanish into the pipe — a --no-doc send uploaded everything,
  # wrote no ownership event, and still said UPLOADED (2026-11-02).
  local out
  out="$(bash "$e" handoff "$name" --to "$to" --note "$note" ${docarg[@]+"${docarg[@]}"})" \
    || { echo "$out" >&2; step event fail; die "the ownership event was not written — nothing was handed over. Fix the error above and send again."; }
  echo "$out" | sed -n '/^event:/p;/^  note:/p'
  step event done "$to"
  echo "verifying the upload (this is what 'staged' never proved):"
  step upload start
  local up=0; wait_uploaded "$name" "$timeout" || up=$?
  case "$up" in 0) step upload done;; 2) step upload skip "this drive does not report upload state";; *) step upload fail;; esac
  [ "$up" = 1 ] && die "the upload did not finish — do NOT edit '$name' here.
     Re-run 'tandem send' when the network settles; the event is already recorded."

  if [ "$hold" = 1 ]; then
    echo
    if claude_running; then
      echo "  ⚠ Claude is running, so this Mac was NOT locked out of '$name'."
      echo "    Quit Claude, then:  tandem hold \"$name\" --to $to"
    else
      cmd_hold "$name" --to "$to"
    fi
  fi

  echo
  if [ "$up" = 2 ]; then
    echo "  STAGED (upload state unavailable on this drive). '$to' pulls it with:"
  else
    echo "  UPLOADED. '$to' can pull it now:"
  fi
  echo "      $(receive_cmd "$to" "$name")"
  echo "  Do not edit '$name' on $ME until it comes back."

  if [ "$wait_ack" = 1 ]; then
    echo
    echo "waiting for $to to claim it (Ctrl-C to stop)..."
    step deliver wait "$to"
    local start=$SECONDS
    while [ $((SECONDS-start)) -lt "$timeout" ]; do
      ls "$PROJECTS/$name/.handoff/events" >/dev/null 2>&1
      if ev="$(newest_event "$name")"; then
        IFS=$'\t' read -r verb machine _to at _doc <<< "$ev"
        [ "$verb" = "claim" ] && [ "$machine" = "$to" ] && {
          step deliver done "$at"
          echo "  ✓ DELIVERED — $to claimed '$name' at $at"; return 0; }
      fi
      printf "\r  %ds" $((SECONDS-start)); sleep 10
    done
    echo
    echo "  no claim after ${timeout}s — $to is probably asleep. It lands when it wakes."
  fi
}

# The receive side, in one verb: wait for the event, verify every file against the
# manifest, define the project here if this Mac has never seen it, claim it, and put
# the handoff document on the clipboard so the Claude session is one paste away.
cmd_receive(){
  local name="" timeout=900 defer=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --timeout) timeout="${2:-}"; shift 2;;
      --defer)   defer=1; shift;;
      *) [ -n "$name" ] || name="$1"; shift;;
    esac
  done
  [ -n "$name" ] || die "usage: tandem receive <Project> [--defer] [--timeout SECONDS]"
  take_lock "project-$name"
  local e; e="$(engine)" || exit 1
  need_profile_engine "$e"
  local start=$SECONDS

  # 1. the ownership event addressed to this Mac
  echo "receiving '$name' on $ME"
  local ev verb machine to at doc ready=0 evrc=0
  if ev="$(newest_event "$name")"; then
    IFS=$'\t' read -r verb machine to at doc <<< "$ev"
    { [ "$verb" = "handoff" ] && [ "$to" = "$ME" ]; } && ready=1
    { [ "$verb" = "claim" ] && [ "$machine" = "$ME" ]; } && ready=2
  else evrc=$?; fi
  [ "$ready" = 0 ] && step event wait
  if [ "$ready" = 0 ]; then
    echo "waiting for a handoff addressed to $ME..."
    local hinted=0
    while [ $((SECONDS-start)) -lt "$timeout" ]; do
      if [ "$hinted" = 0 ] && [ $((SECONDS-start)) -ge 60 ]; then
        hinted=1; echo; drive_hint || true
      fi
      ls "$HANDOFF" >/dev/null 2>&1; ls "$PROJECTS" >/dev/null 2>&1
      ls "$PROJECTS/$name" >/dev/null 2>&1; ls "$PROJECTS/$name/.handoff/events" >/dev/null 2>&1
      if ev="$(newest_event "$name")"; then
        evrc=0
        IFS=$'\t' read -r verb machine to at doc <<< "$ev"
        { [ "$verb" = "handoff" ] && [ "$to" = "$ME" ]; } && { ready=1; break; }
        { [ "$verb" = "claim" ] && [ "$machine" = "$ME" ]; } && { ready=2; break; }
      else evrc=$?; fi
      printf "\r  %ds" $((SECONDS-start)); sleep 6
    done
    echo
  fi
  # Never claim a project that was not handed to this Mac -- that is how both Macs end
  # up believing they own it, which is exactly what produces iCloud conflict copies.
  case "$ready" in
    1) step event done "$machine"; echo "  handed off by $machine at $at";;
    2) step event done "$ME"; echo "  already claimed by $ME at $at — re-verifying and refreshing the document";;
    *) step event fail
       if [ "$evrc" = 2 ]; then
         die "an event for '$name' IS on the drive but could not be read after ${timeout}s.
     That is a delivery problem, not a missing handoff — the file is listed at its full
     size with no content behind it. Check the drive is awake and has space, then re-run.
     To see it for yourself:
         ls -l \"$PROJECTS/$name/.handoff/events\"    # the file is there
         cat \"$PROJECTS/$name/.handoff/events\"/*.json   # and reads empty"
       fi
       if drive_state >/dev/null; then
         drive_hint
         die "no handoff to $ME arrived for '$name' within ${timeout}s — and this Mac's iCloud
     Drive is not syncing, so that is the likelier cause than the sender. Open Finder ›
     iCloud Drive, wait for it to settle (brctl status shows client:idle), then re-run.
     Newest event seen here: ${verb:-none} ${machine:+by $machine}${to:+ -> $to} ${at:-}"
       fi
       die "no handoff to $ME arrived for '$name' within ${timeout}s.
     Newest event: ${verb:-none} ${machine:+by $machine}${to:+ -> $to} ${at:-}
     Check the sender ran: tandem send \"$name\" --to $ME   (and that the name matches
     'scutil --get ComputerName' over there), or look at: tandem status";;
  esac

  # 2. every file, verified against the manifest -- an un-uploaded file is ABSENT here,
  #    not dataless, so a listing alone can never tell you the transfer was complete.
  local left=$(( timeout - (SECONDS - start) )); [ "$left" -lt 60 ] && left=60
  echo "waiting for the files:"
  step files start
  local wfrc=0; wait_for_files "$name" "$left" || wfrc=$?
  [ "$wfrc" = 0 ] && step files done || step files fail
  if [ "$wfrc" = 2 ]; then
    die "'$name' has been EDITED since it was handed over — nothing was claimed.
     The files above are present; they no longer match the manifest written at handoff.
     That is normal when work continued here without running 'tandem receive' (a Claude
     session does the work; it never records a claim). Nothing is wrong with the data.
     Close it properly from the Mac that did the work:
         tandem send \"$name\" --to <the other Mac> --note \"...\"
     which writes a fresh manifest from the current files, then receive there."
  elif [ "$wfrc" != 0 ]; then
    die "the files did not all arrive — nothing was claimed.
     Re-run when $machine is awake; 'tandem status' shows who holds it."
  fi

  # 3. define the project here if this Mac has never seen it. It writes spaces.json, which
  #    a running Claude overwrites -- so with --defer, claim now and define it once Claude
  #    quits (`tandem settle`), rather than stop the whole receive for a quit.
  local deferred=()
  if have_project "$name"; then
    echo "  project already defined on this Mac"
    step define skip
  elif [ "$defer" = 1 ] && claude_running && [ -n "$(find_definition "$name")" ]; then
    echo "  Claude is open, so the project is defined when it quits"
    deferred+=(define); step define wait
  else
    local def; def="$(find_definition "$name")"
    if [ -z "$def" ]; then
      # A folder in the shared tree that is not a Claude project on the sender -- a
      # plumbing test, or files shared without a project. Verified and claimed all the
      # same; there is simply nothing to define here. Failing now would throw away a
      # transfer that already checked out by md5.
      echo "  ! no project definition was sent — files only"
      echo "    ('$name' is not a Claude project on the sending Mac, so there is none to add)"
    else
      require_claude_quit
      cmd_project_import "$name" | sed '/tandem pickup/d'
      [ "${PIPESTATUS[0]}" -eq 0 ] || die "could not add the project definition"
      step define done
    fi
  fi

  # 4. claim it, and show the document
  bash "$e" pickup "$name" || { step claim fail; die "could not claim '$name'"; }
  step claim done

  # memory follows ownership: install the snapshot the sender took, if one arrived
  ls "$PROJECTS/$name/.handoff" "$PROJECTS/$name/.handoff/memory" >/dev/null 2>&1
  ls "$PROJECTS/$name/.handoff/memory/"*/ >/dev/null 2>&1
  if [ ${#deferred[@]} -gt 0 ] && ls "$PROJECTS/$name/.handoff/memory/"*/snapshot.json >/dev/null 2>&1; then
    deferred+=(memory); step memory wait
  elif have_project "$name" && ls "$PROJECTS/$name/.handoff/memory/"*/snapshot.json >/dev/null 2>&1; then
    if claude_running && [ "$defer" = 1 ]; then
      deferred+=(memory); step memory wait
    elif claude_running; then
      echo
      echo "  ⚠ a memory snapshot came with this project, but Claude is running."
      echo "    Quit Claude, then:  tandem memory-install \"$name\" --merge"
    else
      # merge, not replace: it only adds, so nothing either Mac learned is lost
      cmd_memory_install "$name" --merge && step memory done
    fi
  else
    step memory skip
  fi

  # 5. if this Mac locked itself out when it sent the project away, undo that now
  if [ -f "$HOLDDIR/$name.json" ]; then
    if claude_running && [ "$defer" = 1 ]; then
      deferred+=(unlock); step unlock wait
    elif claude_running; then
      echo
      echo "  ⚠ '$name' is still locked on this Mac and Claude is running."
      echo "    Quit Claude, then:  tandem release \"$name\""
    else
      cmd_release "$name" && step unlock done
    fi
  fi

  if [ ${#deferred[@]} -gt 0 ]; then
    settle_mark "$name" "${deferred[@]}"
    echo
    echo "  ⏸ claimed, and still to do here once Claude (${PROFILE:-default}) quits: ${deferred[*]}"
    echo "    Tandem's app does it automatically; by hand: tandem ${PROFILE:+--profile $PROFILE }settle \"$name\""
  fi

  # 6. the whole point of the trip: get that document into the Claude session
  if [ -n "$doc" ] && [ -f "$PROJECTS/$name/$doc" ]; then step brief done "$doc"; else step brief skip; fi
  if [ -n "$doc" ] && [ -f "$PROJECTS/$name/$doc" ] && [ -z "${TANDEM_NO_CLIPBOARD:-}" ] && command -v pbcopy >/dev/null 2>&1; then
    pbcopy < "$PROJECTS/$name/$doc"
    echo
    echo "  ✓ $doc copied to the clipboard — open '$name' in Claude and paste it."
  fi
}

# Finish a deferred receive: define the project, merge its memory, undo a hold — the parts
# that write spaces.json, so they wait for this profile's Claude to quit.
cmd_settle(){
  local only="${1:-}" f rc=0
  take_lock "settle-$ME"
  ls "$SETTLEDIR"/*.json >/dev/null 2>&1 || { echo "  nothing waiting to settle for $ME"; return 0; }
  for f in "$SETTLEDIR"/*.json; do
    [ -f "$f" ] || continue
    local rec name side needs
    rec="$(python3 -c 'import json,sys;d=json.load(open(sys.argv[1]));print(d["project"]+"\t"+d["side"]+"\t"+" ".join(d.get("needs",[])))' "$f" 2>/dev/null)" || continue
    IFS=$'\t' read -r name side needs <<< "$rec"
    [ "$side" = "$ME" ] || continue
    [ -z "$only" ] || [ "$only" = "$name" ] || continue
    if claude_running; then
      echo "  '$name' waits for Claude (${PROFILE:-default}) to quit: $needs"; rc=3; continue
    fi
    echo "settling '$name' as $ME: $needs"
    if ! have_project "$name"; then
      if [ -n "$(find_definition "$name")" ]; then
        cmd_project_import "$name" | sed '/tandem pickup/d'
        [ "${PIPESTATUS[0]}" -eq 0 ] || { echo "  ✗ could not add the project definition" >&2; step define fail; rc=1; continue; }
        step define done
      else
        echo "  ! no project definition on the drive — files only"
      fi
    fi
    if have_project "$name" && ls "$PROJECTS/$name/.handoff/memory/"*/snapshot.json >/dev/null 2>&1; then
      if cmd_memory_install "$name" --merge; then step memory done; else step memory fail; rc=1; fi
    fi
    if [ -f "$HOLDDIR/$name.json" ]; then
      if cmd_release "$name"; then step unlock done; else step unlock fail; rc=1; fi
    fi
    [ "$rc" = 0 ] && rm -f "$f" && ok "'$name' settled — open Claude (${PROFILE:-default}) and it is there"
  done
  return "$rc"
}

# Everything Tandem knows about where things are, across every Mac that publishes a
# presence card: see bin/tandem-ledger.py.
ledger(){
  local tmp; tmp="$(mktemp -t tandem-profiles)"
  "$HERE/bin/tandem-profile" list --json > "$tmp" 2>/dev/null || echo "[]" > "$tmp"
  python3 "$HERE/bin/tandem-ledger.py" "$1" "$ROOT" "$BASE_ME" "$CONFDIR" "$tmp" "${@:2}"
  local rc=$?; rm -f "$tmp"; return $rc
}
cmd_presence(){ ledger presence "$(cat "$HERE/VERSION" 2>/dev/null || echo unknown)" "$(drive_state 2>/dev/null)"; }
cmd_where(){
  if [ "${1:-}" = --json ]; then ledger where "$(drive_state 2>/dev/null)"; return; fi
  TANDEM_LEDGER_TEXT=1 ledger where "$(drive_state 2>/dev/null)"
}


# Ask the side holding a project to hand it here. Writes a request beside the project's
# events (never among them); the holder's Tandem notices it, and the next event consumes it.
cmd_ask(){
  local name="${1:-}"; [ -n "$name" ] || die "usage: tandem ask <Project> [--note ...]"
  local note=""; [ "${2:-}" = --note ] && note="${3:-}"
  [ -d "$PROJECTS/$name" ] || die "'$name' is not in the shared tree"
  mkdir -p "$PROJECTS/$name/.handoff/requests"
  python3 - "$PROJECTS/$name/.handoff/requests" "$ME" "$note" <<'PY2'
import json,sys,os,datetime
d,me,note=sys.argv[1:4]
ts=datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
json.dump({"from":me,"note":note,"at":ts},open(os.path.join(d,f"{ts}-{me}.json"),"w"),indent=2)
PY2
  ok "asked for '$name' as $ME — the holder's Tandem shows the request once the drive carries it"
}

# ---- one implementation for every client --------------------------------------------
#
# The app, `tandem watch` and scripts all go through these: the same inbox (computed in
# bin/tandem-ledger.py), the same settings file, the same locks.

CONFIG="$CONFDIR/config.json"
cfg_default(){ case "$1" in on-arrival) echo ask;; on-brief) echo ask;; watch-interval) echo 60;; *) return 1;; esac; }
cfg_valid(){
  case "$1=$2" in
    on-arrival=ask|on-arrival=auto|on-arrival=off) ;;
    on-brief=ask|on-brief=auto) ;;
    watch-interval=*) [[ "$2" =~ ^[0-9]+$ ]] && [ "$2" -ge 10 ] || return 1;;
    *) return 1;;
  esac
}
cfg_get(){
  local v; v="$(python3 -c 'import json,sys
try: print(json.load(open(sys.argv[1])).get(sys.argv[2],""))
except Exception: print("")' "$CONFIG" "$1")"
  [ -n "$v" ] && echo "$v" || cfg_default "$1"
}
cmd_config(){
  local keys="on-arrival on-brief watch-interval" k
  case "${1:-list}" in
    list|--json)
      if [ "${1:-}" = --json ] || [ "${2:-}" = --json ]; then
        python3 - "$CONFIG" $(for k in $keys; do echo "$k=$(cfg_get "$k")"; done) <<'PY2'
import json,sys
print(json.dumps({"schema":1, **dict(a.split("=",1) for a in sys.argv[2:])}, indent=2))
PY2
      else
        for k in $keys; do printf '%-16s %s\n' "$k" "$(cfg_get "$k")"; done
      fi;;
    get) [ -n "${2:-}" ] && cfg_default "$2" >/dev/null || die "usage: tandem config get <key> — keys: $keys"; cfg_get "$2";;
    set) [ -n "${3:-}" ] || die "usage: tandem config set <key> <value>
     on-arrival      ask | auto | off   when a handoff arrives for a profile here
     on-brief        ask | auto         when /handoff leaves a send intent
     watch-interval  seconds (≥10)      how often tandem watch looks"
         cfg_valid "$2" "$3" || die "'$3' is not a valid value for '$2' — see: tandem config set"
         mkdir -p "$CONFDIR"
         python3 - "$CONFIG" "$2" "$3" <<'PY2'
import json,sys,os
f,k,v=sys.argv[1:4]
try: d=json.load(open(f))
except Exception: d={}
d[k]=v; tmp=f+".tmp"; json.dump(d,open(tmp,"w"),indent=2); os.replace(tmp,f)
PY2
         ok "$2 = $3";;
    *) die "usage: tandem config [list|get <key>|set <key> <value>] [--json]";;
  esac
}

# A project is sent, received or settled by one process at a time on this Mac, whichever
# client started it: the app and `tandem watch` may both react to the same arrival. The
# loser exits 75 (EX_TEMPFAIL), which clients treat as "already in hand", not a failure.
LOCKDIR="$CONFDIR/locks"
take_lock(){
  local l="$LOCKDIR/${1//\//_}"
  mkdir -p "$LOCKDIR"
  if ! mkdir "$l" 2>/dev/null; then
    local pid; pid="$(cat "$l/pid" 2>/dev/null)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      echo "error: $1 is already in progress (pid $pid)" >&2; exit 75
    fi
    rm -rf "$l"; mkdir "$l" || { echo "error: could not lock $1" >&2; exit 75; }
  fi
  echo $$ > "$l/pid"
  trap 'rm -rf "'"$l"'"' EXIT
}

cmd_inbox(){
  case "${1:-}" in
    dismiss)
      [ -n "${2:-}" ] || die "usage: tandem inbox dismiss <key>   (keys: tandem inbox)"
      mkdir -p "$CONFDIR"
      python3 - "$CONFDIR/dismissed.json" "$2" <<'PY2'
import json,sys,os
f,k=sys.argv[1:3]
try: d=json.load(open(f))
except Exception: d=[]
if k not in d: d.append(k)
tmp=f+".tmp"; json.dump(d[-400:],open(tmp,"w"),indent=2); os.replace(tmp,f)
PY2
      ok "dismissed $2";;
    --json) TANDEM_LEDGER_INBOX=1 ledger where "$(drive_state 2>/dev/null)";;
    "")     TANDEM_LEDGER_INBOX=1 TANDEM_LEDGER_TEXT=1 ledger where "$(drive_state 2>/dev/null)";;
    *) die "usage: tandem inbox [--json] | tandem inbox dismiss <key>";;
  esac
}

# The brief a project travelled with: the one its newest event names, else the newest
# HANDOFF*.md. Prints it; --path prints where it is; --copy puts it on the clipboard;
# --open also brings this side's Claude forward — paste it there.
cmd_brief(){
  local name="" mode=print open=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --path) mode=path; shift;;
      --copy) mode=copy; shift;;
      --open) open=1; [ "$mode" = print ] && mode=copy; shift;;
      *) [ -n "$name" ] || name="$1"; shift;;
    esac
  done
  [ -n "$name" ] || die "usage: tandem brief <Project> [--path|--copy] [--open]"
  [ -d "$PROJECTS/$name" ] || die "'$name' is not in the shared tree"
  local doc="" ev
  if ev="$(newest_event "$name")"; then IFS=$'\t' read -r _v _m _t _a doc <<< "$ev"; fi
  # engines ≤ v8 can shift the doc into the note on a claim; the newest file is the fallback
  [ -n "$doc" ] && [ -f "$PROJECTS/$name/$doc" ] || doc="$(cd "$PROJECTS/$name" && ls -t HANDOFF*.md 2>/dev/null | head -1)"
  [ -n "$doc" ] || die "'$name' has no HANDOFF*.md — run /handoff in its Claude session"
  local f="$PROJECTS/$name/$doc"
  case "$mode" in
    path) echo "$f";;
    copy) pbcopy < "$f" && ok "$doc is on the clipboard";;
    *)    cat "$f";;
  esac
  [ "$open" = 1 ] && "$HERE/bin/tandem-profile" desktop "${PROFILE:-default}" >/dev/null && ok "Claude (${PROFILE:-default}) is in front — open '$name' and paste"
  return 0
}

# Headless Tandem: what the app does in the background, for a server, a script or launchd.
cmd_watch(){
  case "${1:-}" in
    --install|--uninstall) watch_agent "$1"; return;;
  esac
  python3 "$HERE/bin/tandem-ledger.py" watch "$HERE/bin/tandem" "$CONFDIR" "$@"
}
watch_agent(){
  local label=local.claude-tandem.watch plist="$HOME/Library/LaunchAgents/local.claude-tandem.watch.plist"
  local log="$HOME/Library/Logs/claude-tandem-watch.log"
  if [ "$1" = --uninstall ]; then
    launchctl bootout "gui/$(id -u)/$label" 2>/dev/null
    rm -f "$plist" && ok "tandem watch no longer runs at login"
    return
  fi
  mkdir -p "$(dirname "$plist")" "$(dirname "$log")"
  # the wrapper Homebrew installs is stable across upgrades; from a clone, this script
  local exe="$HERE/bin/tandem"; command -v tandem >/dev/null && exe="$(command -v tandem)"
  python3 - "$plist" "$label" "$exe" "$log" "$PATH" <<'PY2'
import plistlib,sys
f,label,exe,log,path=sys.argv[1:6]
plistlib.dump({"Label":label,"ProgramArguments":[exe,"watch","--json"],"RunAtLoad":True,"KeepAlive":True,
               "StandardOutPath":log,"StandardErrorPath":log,"EnvironmentVariables":{"PATH":path},
               "ProcessType":"Background"},open(f,"wb"))
PY2
  launchctl bootout "gui/$(id -u)/$label" 2>/dev/null
  launchctl bootstrap "gui/$(id -u)" "$plist" || die "launchctl could not load $plist"
  ok "tandem watch runs at login, as $label — events in $log"
  echo "    Don't also run the app with automatic settings: both would work, but each notifies."
}

cmd_wait(){
  local name="" timeout=600
  while [ $# -gt 0 ]; do
    case "$1" in
      --timeout) timeout="${2:-}"; shift 2;;
      *) [ -n "$name" ] || name="$1"; shift;;
    esac
  done
  [ -n "$name" ] || die "usage: tandem wait <Project> [--timeout SECONDS]"
  wait_for_files "$name" "$timeout"
}

case "${1:-help}" in
  # accounts on this Mac: bin/tandem-profile does that half
  profile) shift; exec "$HERE/bin/tandem-profile" "$@";;
  menubar) shift; exec "$HERE/bin/tandem-profile" menubar "$@";;
  send)     shift; cmd_send "$@";;
  hold)     shift; cmd_hold "$@";;
  release)  shift; cmd_release "$@";;
  memory-snapshot) shift; cmd_memory_snapshot "$@";;
  memory-install)  shift; cmd_memory_install "$@";;
  receive)  shift; cmd_receive "$@";;
  use-root) shift; cmd_use_root "$@";;
  deploy)   shift; cmd_deploy "$@";;
  check)    shift; cmd_check "$@";;
  doctor)   shift; cmd_doctor "$@";;
  link)     shift; cmd_link "$@";;
  path)     shift; cmd_path "$@";;
  migrate)  shift; cmd_migrate "$@";;
  rename)   shift; cmd_rename "$@";;
  project-list)   shift; cmd_project_list "$@";;
  project-export) shift; cmd_project_export "$@";;
  project-import) shift; cmd_project_import "$@";;
  project-repath) shift; cmd_project_repath "$@";;
  wait)           shift; cmd_wait "$@";;
  settle)         shift; cmd_settle "$@";;
  where)          shift; cmd_where "$@";;
  presence)       shift; cmd_presence "$@";;
  ask)            shift; cmd_ask "$@";;
  inbox)          shift; cmd_inbox "$@";;
  config)         shift; cmd_config "$@";;
  brief)          shift; cmd_brief "$@";;
  watch)          shift; cmd_watch "$@";;
  status|handoff|pickup|log|conflicts|materialize)
            e="$(engine)" || exit 1; exec bash "$e" "$@";;
  skill)    shift; f="$HERE/skills/handoff/SKILL.md"; [ -f "$f" ] || die "missing $f"
            echo "$f"; [ "${1:-}" = --print ] || open -R "$f";;
  version|-v|--version) cat "$HERE/VERSION" 2>/dev/null || echo unknown;;
  help|-h|--help) usage;;
  *) echo "unknown command: $1" >&2; echo; usage; exit 1;;
esac
