#!/bin/bash
# `claude-profile` is now `tandem profile` (Claude Tandem). Kept so habits and any
# launcher built before the rename keep working; `tandem profile app --all` rebuilds
# launchers to call the new name.
echo "note: 'claude-profile' is now 'tandem profile'" >&2
exec "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/tandem-profile" "$@"
